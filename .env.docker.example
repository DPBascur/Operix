# Copiar a .env; generar valores propios. No usar credenciales nativas.
OPERIX_DOCKER_DB_PASSWORD=replace-with-random-local-password
OPERIX_DOCKER_SECRET_KEY=replace-with-random-local-django-key
OPERIX_BACKEND_PORT=18000
OPERIX_FRONTEND_PORT=13000
# Solo para compose.gpu.yaml: archivos individuales, nunca un directorio experiments.
# PERSON: yolo11n.pt COCO; verificar SHA documentado en la guía Docker.
OPERIX_PERSON_WEIGHTS_HOST=
OPERIX_FORKLIFT_WEIGHTS_HOST=
# Directorio exclusivo con demos autorizadas; por defecto assets/demo.
OPERIX_INPUT_HOST=./assets/demo
# Opcional: ruta interna de C, si fue incorporada expresamente al directorio de demos.
OPERIX_DOCKER_DEMO_C=
