# Secretos y configuración local
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# Confidencialidad: documentación local excluida por defecto.
# Solo el índice y los artefactos técnicos revisados de arquitectura se admiten.
/docs/*
!/docs/architecture/
/docs/EntrevistaPrevencionista_TT-Realizada.pdf

# Entrevistas y derivados, en cualquier ubicación (sin excepciones automáticas).
*[Ee][Nn][Tt][Rr][Ee][Vv][Ii][Ss][Tt]*
*[Tt][Rr][Aa][Nn][Ss][Cc][Rr][Ii][Pp]*
*[Cc][Oo][Nn][Ff][Ii][Dd][Ee][Nn][Cc][Ii][Aa][Ll]*
*[Cc][Oo][Nn][Ff][Ii][Dd][Ee][Nn][Tt][Ii][Aa][Ll]*
[Pp][Rr][Ii][Vv][Aa][Dd][Oo]/
[Pp][Rr][Ii][Vv][Aa][Dd][Aa]/

# Guardar aquí cualquier futuro documento sensible, captura o derivado:
# docs/ (fuera de architecture/), confidential/ o privado/.
# Git no detecta información sensible por contenido. Revisar antes de agregar.
# Las plantillas vacías requieren revisión y una excepción explícita posterior.
*.m4a
*.mp3
*.wav
*.aac
*.flac
*.ogg
*.opus
*.wma

# Entornos y dependencias instaladas
.venv/
venv/
env/
node_modules/

# Cachés y resultados de herramientas
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.next/
.coverage
coverage/
*.tsbuildinfo
*.log
.DS_Store
Thumbs.db

# Pesos y videos de ejecución: conservar procedencia por separado
*.pt
*.pth
*.onnx
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.m4v

# Excepciones revisadas: únicamente los clips sintéticos y la salida visual de demo.
!/assets/demo/forklift_human_nearmiss_ceiling00.mp4
!/assets/demo/warehouse_fire_ceiling04.mp4
!/assets/demo/warehouse_fire_ceiling04_operix_annotated.mp4

# Auxiliares LaTeX; no excluye fuentes ni documentos PDF
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc

# Estas reglas no retiran archivos que Git ya tiene versionados.
/Modelo_Trabajo_Titulo_LaTeX/main.pdf
/Modelo_Trabajo_Titulo_LaTeX/build/main.pdf
